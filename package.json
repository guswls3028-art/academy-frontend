{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "pnpm": {
    "overrides": {
      "@jridgewell/gen-mapping": "0.3.13",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@>=5": "5.0.9",
      "form-data": "4.0.6",
      "linkify-it": "5.0.2",
      "markdown-it": "14.3.0",
      "js-yaml": "4.3.1",
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:remote": "env-cmd -f .env.remote vite",
    "build": "vite build && node scripts/check-bundle-budgets.mjs && node scripts/ensure-spa-mode.js",
    "guard:legacy-api": "node scripts/guard-legacy-api-routes.mjs && node scripts/guard-workspace-route-names.mjs && node scripts/guard-staff-mobile-contract.mjs && node scripts/guard-messaging-policy.mjs && pnpm guard:test-coverage && pnpm guard:e2e-safety && pnpm guard:deployment-governance && pnpm guard:runtime-recovery",
    "guard:test-coverage": "node --test scripts/tests/e2e-gate-coverage.test.mjs",
    "guard:e2e-safety": "node scripts/guard-e2e-safety.mjs && node scripts/guard-strict-e2e-imports.mjs",
    "guard:deployment-governance": "node scripts/guard-deployment-governance.mjs && node --test scripts/tests/visual-audit-workflow.test.mjs",
    "guard:runtime-recovery": "node --test scripts/tests/chunk-load-error.test.mjs scripts/tests/workspace-deployment-contract.test.mjs",
    "verify:student-routes": "node scripts/verify-student-routes.mjs",
    "verify:teacher-routes": "node scripts/verify-teacher-routes.mjs",
    "verify:landing-routes": "node scripts/verify-landing-routes.mjs",
    "verify:admin-routes": "node scripts/verify-admin-routes.mjs",
    "verify:product-analytics": "node scripts/verify-product-analytics-registry.mjs",
    "verify:tenant-availability": "node scripts/verify-tenant-availability.mjs",
    "capture:promo-student": "node scripts/capture-promo-student-app.mjs",
    "verify:routes": "pnpm verify:student-routes && pnpm verify:teacher-routes && pnpm verify:landing-routes && pnpm verify:admin-routes",
    "refactor:inventory": "node scripts/refactor-boundary-snapshot.mjs",
    "refactor:budget": "node scripts/refactor-boundary-snapshot.mjs --budget scripts/refactor-budget-baseline.json",
    "api-types:generate": "node scripts/generate-api-types.mjs",
    "api-types:check": "node scripts/generate-api-types.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:canary": "playwright test e2e/smoke/production-canary.spec.ts --project=chromium --reporter=list",
    "test:e2e:gate": "playwright test --config=playwright.pr-gate.config.ts",
    "test:e2e:gate:readonly": "playwright test --config=playwright.pr-gate.config.ts --project=pr-readonly-4",
    "test:e2e:gate:mock": "playwright test --config=playwright.pr-gate.config.ts --project=pr-route-mocks --no-deps",
    "test:e2e:manual-grading-shortcuts": "playwright test e2e/admin/manual-exam-grading.mock.spec.ts --config=playwright.cross-browser.config.ts --grep @manual-grading-shortcuts",
    "test:e2e:release": "playwright test e2e/shared/e2e-safety-policy.spec.ts e2e/admin/01-login-dashboard.spec.ts e2e/student/01-login-dashboard.spec.ts e2e/smoke/smoke.spec.ts e2e/auth/account-recovery-modal.spec.ts e2e/auth/first-login-guide.mock.spec.ts e2e/admin/student-custom-columns.mock.spec.ts e2e/smoke/deep-operational-smoke.spec.ts e2e/smoke/production-canary.spec.ts e2e/student/student-domain-guardrails.spec.ts e2e/promo-pricing-single-plan.spec.ts e2e/refactor/promo-router.spec.ts e2e/refactor/landing-router.spec.ts e2e/admin/manual-exam-grading.mock.spec.ts e2e/admin/staff-operations-contract.mock.spec.ts e2e/admin/score-entry-autosave.spec.ts e2e/admin/individual-score-report.spec.ts e2e/admin/student-score-trend.spec.ts e2e/student/reported-score-submission.spec.ts e2e/teacher/attendance-undo-secession-local.spec.ts e2e/student/video-player-mobile-controls.spec.ts e2e/student/video-cdn-service-error.mock.spec.ts e2e/student/03-public-video-refactor.spec.ts e2e/flows/homework-scores-inventory-data-flow.spec.ts e2e/flows/video-session-data-flow.spec.ts",
    "test:e2e:landing-routes": "playwright test e2e/refactor/landing-router.spec.ts",
    "test:e2e:visual-audit": "playwright test e2e/visual/design-system-route-audit.spec.ts --project=chromium --reporter=list",
    "test:e2e:local": "playwright test e2e/_local/",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@rollup/rollup-linux-x64-gnu": "^4.60.0",
    "@rollup/rollup-win32-x64-msvc": "^4.62.3",
    "@sentry/react": "^10.43.0",
    "@swc/core-linux-x64-gnu": "^1.15.21",
    "@swc/core-win32-x64-msvc": "^1.15.21",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-color": "^2.12.0",
    "@tiptap/extension-image": "^2.12.0",
    "@tiptap/extension-link": "^2.12.0",
    "@tiptap/extension-placeholder": "^2.12.0",
    "@tiptap/extension-text-align": "^2.12.0",
    "@tiptap/extension-text-style": "^2.12.0",
    "@tiptap/extension-underline": "^2.12.0",
    "@tiptap/react": "^2.12.0",
    "@tiptap/starter-kit": "^3.29.2",
    "antd": "^6.2.2",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.13",
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "hls.js": "^1.6.15",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "lucide-react": "^0.563.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router": "8.3.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@jridgewell/gen-mapping": "0.3.13",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "autoprefixer": "10",
    "dotenv": "^17.3.1",
    "env-cmd": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^17.8.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.3"
  }
}
